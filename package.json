{
	"name": "@indigomultimediateam/indigo-bs",
	"version": "1.0.0-beta2",
	"description": "Indigo’s shared bs (build system) utils and configs",
	"homepage": "https://github.com/IndigoMultimediaTeam/indigo-bs#readme",
	"bugs": {
		"url": "https://github.com/IndigoMultimediaTeam/indigo-bs/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IndigoMultimediaTeam/indigo-bs.git"
	},
	"license": "ISC",
	"author": "Jan Andrle <jan.andrle@indigo.cz>",
	"type": "module",
	"exports": {
		"./biome.json": "./biome.json",
		"./tsconfig.json": "./tsconfig.json",
		"./tsconfig.react.json": "./tsconfig.react.json"
	},
	"files": [
		"bs-shared",
		"install.sh",
		"biome.json",
		".editorconfig",
		"tsconfig.json",
		"tsconfig.react.json"
	],
	"scripts": {
		"prepare": "bs/npm/hooks/prepare",
		"lint": "echo '\\033[33mUse `bs` (see `bs/README.md`) instead of `npm run lint`\\033[0m' && bs/lint.sh"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.12",
		"fallow": "~3.23",
		"lockfile-lint": "~5.0",
		"npm-check-updates": "~23.1",
		"npq": "~3.27"
	},
	"peerDependencies": {
		"nodejsscript": "~1",
		"typescript": "~7.0"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://npm.pkg.github.com"
	},
	"allowScripts": {
		"npq@2.0.23": true
	}
}
